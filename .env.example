# Copy file nay thanh ".env" va dien thong tin cua ban vao.
# File ".env" duoc chan trong .gitignore nen KHONG BAO GIO bi day len GitHub.

# 1. Tai khoan dang nhap PTSC PMS (https://pms-web.ptscmc.com.vn)
PMS_USERNAME=your_pms_username
PMS_PASSWORD=your_pms_password

# 2. GitHub Fine-grained Personal Access Token (chi cap quyen cho repo LQP-MC-Dashboard)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxx
GITHUB_OWNER=huynhphathuy-mech
GITHUB_REPO=LQP-MC-Dashboard
GITHUB_BRANCH=main
